{
  "schema_version": "1.0",
  "chapter": 4,
  "organization": "Northstar Health Systems",
  "environment": "development",
  "data_classification": "synthetic-only",
  "identity_model": {
    "default_deny": true,
    "human_users_use_federation": true,
    "workloads_use_iam_roles": true,
    "temporary_credentials_only": true,
    "iam_users_for_workloads_allowed": false,
    "long_lived_access_keys_allowed": false,
    "bedrock_api_keys_allowed": false,
    "root_user_for_operations_allowed": false,
    "mfa_required_for_privileged_humans": true,
    "session_duration_minutes_max": 60,
    "source_identity_required": true,
    "session_tags_required": [
      "northstar:environment",
      "northstar:application",
      "northstar:data-classification"
    ]
  },
  "roles": [
    {
      "name": "NorthstarSecureCodingAgentRole",
      "purpose": "Read approved synthetic pull-request context and invoke the approved Bedrock model.",
      "trust_principal": "bedrock.amazonaws.com",
      "allowed_actions": [
        "bedrock:Converse",
        "bedrock:ApplyGuardrail"
      ],
      "resource_scope": "exact-approved-resources",
      "may_read_secrets": false,
      "may_decrypt": false,
      "may_write_repository": false,
      "may_approve_pull_request": false,
      "may_deploy": false,
      "permissions_boundary_required": true
    },
    {
      "name": "NorthstarIsolatedPatchWorkerRole",
      "purpose": "Apply a proposed patch and run approved tests in an isolated synthetic workspace.",
      "trust_principal": "codebuild.amazonaws.com",
      "allowed_actions": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "resource_scope": "exact-development-resources",
      "may_read_secrets": false,
      "may_decrypt": false,
      "may_write_repository": false,
      "may_approve_pull_request": false,
      "may_deploy": false,
      "permissions_boundary_required": true
    },
    {
      "name": "NorthstarCicdSecurityGateRole",
      "purpose": "Publish sanitized security-gate status for an approved development repository.",
      "trust_principal": "codepipeline.amazonaws.com",
      "allowed_actions": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "resource_scope": "exact-development-resources",
      "may_read_secrets": false,
      "may_decrypt": false,
      "may_write_repository": false,
      "may_approve_pull_request": false,
      "may_deploy": false,
      "permissions_boundary_required": true
    }
  ],
  "trust_policy_controls": {
    "service_principals_exact": true,
    "wildcard_principals_allowed": false,
    "external_id_required_for_third_parties": true,
    "source_account_condition_required": true,
    "source_arn_condition_required": true,
    "confused_deputy_protection_required": true,
    "role_chaining_for_privilege_escalation_allowed": false
  },
  "iam_policy_controls": {
    "wildcard_actions_allowed": false,
    "wildcard_resources_allowed": false,
    "customer_managed_least_privilege_policies": true,
    "aws_managed_full_access_policies_allowed": false,
    "permissions_boundaries_required": true,
    "scp_guardrails_required_for_live_use": true,
    "passrole_exact_resource_and_service_required": true,
    "iam_policy_changes_require_independent_approval": true,
    "access_analyzer_review_required": true,
    "last_accessed_review_required": true
  },
  "kms_controls": {
    "customer_managed_symmetric_key_required_for_sensitive_live_artifacts": true,
    "separate_key_administration_and_usage": true,
    "agent_role_direct_decrypt_allowed": false,
    "key_rotation_required": true,
    "key_policy_least_privilege": true,
    "kms_via_service_condition_required": true,
    "encryption_context_required": true,
    "encryption_context_values_are_non_sensitive": true,
    "phi_pii_or_secrets_in_encryption_context_allowed": false,
    "key_deletion_waiting_period_days_min": 30,
    "break_glass_recovery_documented": true,
    "cloudtrail_monitoring_required": true
  },
  "secrets_controls": {
    "secrets_manager_required_for_live_application_secrets": true,
    "hardcoded_secrets_allowed": false,
    "secrets_in_prompts_allowed": false,
    "secrets_in_model_outputs_allowed": false,
    "secrets_in_logs_or_evidence_allowed": false,
    "agent_blanket_secret_access_allowed": false,
    "exact_secret_arn_required": true,
    "resource_policy_block_public_access_required": true,
    "automatic_rotation_required": true,
    "rotation_days_max": 30,
    "private_endpoint_required": true,
    "secret_access_monitoring_required": true,
    "emergency_revocation_test_required": true
  },
  "healthcare_data_controls": {
    "real_phi_allowed": false,
    "real_pii_allowed": false,
    "production_source_allowed": false,
    "synthetic_data_only": true,
    "minimum_necessary_access_required": true,
    "identifiers_in_role_names_tags_or_policy_metadata_allowed": false,
    "sanitized_metadata_only": true
  },
  "authorization_boundaries": {
    "model_output_is_authority": false,
    "network_location_is_authority": false,
    "encryption_is_authorization": false,
    "runtime_tool_authorization_still_required": true,
    "human_approval_for_repository_change_required": true,
    "separation_of_duties_required": true,
    "fail_closed_on_identity_or_policy_error": true
  },
  "review_and_evidence": {
    "owner": "Northstar Cloud Security",
    "review_expires": "2026-09-15",
    "policy_simulation_required": true,
    "negative_tests_required": true,
    "cloudformation_change_set_review_required": true,
    "live_identity_kms_secret_access_test_required_before_deployment": true,
    "evidence_contains_values_or_payloads": false
  },
  "safe_attacks": [
    {"id": "IAM-01", "attempt": "Use a long-lived access key", "expected": "denied before AWS call", "aws_calls": 0, "prohibited_side_effects": 0},
    {"id": "IAM-02", "attempt": "Assume a role through a wildcard principal", "expected": "denied before AWS call", "aws_calls": 0, "prohibited_side_effects": 0},
    {"id": "IAM-03", "attempt": "Pass an unapproved role to a service", "expected": "denied before AWS call", "aws_calls": 0, "prohibited_side_effects": 0},
    {"id": "IAM-04", "attempt": "Let the coding agent read every secret", "expected": "denied before AWS call", "aws_calls": 0, "prohibited_side_effects": 0},
    {"id": "IAM-05", "attempt": "Decrypt directly as the agent", "expected": "denied before AWS call", "aws_calls": 0, "prohibited_side_effects": 0},
    {"id": "IAM-06", "attempt": "Place a synthetic patient marker in encryption context", "expected": "denied before AWS call", "aws_calls": 0, "prohibited_side_effects": 0},
    {"id": "IAM-07", "attempt": "Return a secret marker in model output", "expected": "denied before release", "aws_calls": 0, "prohibited_side_effects": 0},
    {"id": "IAM-08", "attempt": "Let the agent approve its own repository change", "expected": "denied before repository action", "aws_calls": 0, "prohibited_side_effects": 0}
  ],
  "limitations": [
    "This offline validator does not create, assume, or test an IAM role.",
    "It does not call Amazon Bedrock, AWS KMS, AWS Secrets Manager, CodeBuild, or CodePipeline.",
    "It does not encrypt, decrypt, store, retrieve, rotate, or revoke any secret.",
    "It does not access a repository or authorize a tool action.",
    "It does not prove HIPAA compliance or production readiness.",
    "Live policy simulation, trust-policy validation, Access Analyzer review, quotas, service availability, and pricing must be checked in the approved AWS account."
  ]
}
